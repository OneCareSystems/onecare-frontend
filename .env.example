# Default: same-origin /api; Vite proxies it to http://localhost:8080 in dev.
# Used by the central Axios client in src/services/config.js (CFG-02).
# Never hardcode hostnames in components.
VITE_API_BASE_URL=/api
# For direct requests, use http://localhost:8080/api (backend must allow CORS).

# --- Build/dev only (DDP-#49 / DKR-03) ---------------------------------
# Runtime values are NOT baked into the bundle. The production container
# writes /config.json at start (docker/entrypoint.sh) and the app reads it
# before boot; nothing secret may ever appear there or in any VITE_ var.
#
# Dev server proxy target for /api (vite.config.js). Compose dev mode sets
# this to http://backend:8080; local development keeps the default.
# VITE_DEV_PROXY_TARGET=http://localhost:8080
