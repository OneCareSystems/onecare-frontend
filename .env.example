# Default: same-origin /api; Vite proxies it to http://localhost:8080 in dev.
# Used by the central Axios client in src/services/apiClient.js.
# Never hardcode hostnames in components.
VITE_API_BASE_URL=/api
# For direct requests, use http://localhost:8080/api (backend must allow CORS).

# Public slot endpoint: /api/public/doctors/{id}/available-slots?date=...
# Development examples only: replace these with the real clinic contact details.
